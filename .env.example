# Copy this file to .env and fill in your real values.
# Never commit your actual .env file to source control.

# Port the local server listens on
PORT=3000

# Shared secret used to verify Mindbody's webhook signature.
# You set this same value in the Mindbody Developer Portal when creating
# the webhook subscription.
MINDBODY_WEBHOOK_SECRET=replace-with-your-mindbody-webhook-secret

# API token for your GoHighLevel private integration/app. Used to create
# contacts via the GoHighLevel API when a Mindbody client.created event
# comes in.
GHL_API_TOKEN=replace-with-your-gohighlevel-api-token

# Mindbody Public API v6 credentials, used by scheduled-jobs.js to call OUT
# to Mindbody (separate from MINDBODY_WEBHOOK_SECRET above, which is only
# for verifying INCOMING webhooks). Find these in the Mindbody Developer
# Portal for your API application / site.
MINDBODY_API_KEY=replace-with-your-mindbody-api-key
MINDBODY_SITE_ID=replace-with-your-albertson-mindbody-site-id
MINDBODY_SITE_ID_EAST_MEADOW=replace-with-your-east-meadow-mindbody-site-id

# Mindbody staff credentials, used ONLY by migration.js to obtain a staff
# access token (via the /usertoken/issue endpoint) for reading client lists
# across multiple sites. Separate from MINDBODY_API_KEY/SITE_ID above.
MINDBODY_STAFF_USERNAME=replace-with-your-mindbody-staff-username
MINDBODY_STAFF_PASSWORD=replace-with-your-mindbody-staff-password
